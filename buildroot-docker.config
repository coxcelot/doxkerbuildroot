# ============================================================
# Buildroot config FRAGMENT: Docker inside a v86 browser VM
# ============================================================
# STARTING POINT: use the "standard" browser-buildroot config as base
#   https://github.com/Darin755/browser-buildroot  (buildroot 2024.02.5, kernel 6.6)
#   It already provides the REQUIRED prerequisites for Docker:
#     - BR2_TOOLCHAIN_USES_GLIBC=y      (docker-engine/containerd/runc need glibc or musl)
#     - kernel headers >= 5.2           (needed by docker-engine)
#     - BR2_PACKAGE_LIBSECCOMP_ARCH_SUPPORTS=y (x86 is supported)
#
# To build an image with Docker, ADD the settings below to that config
# (via `make menuconfig` or by appending, then `make`).
#
# The 6 packages you listed:
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBSECCOMP=y
BR2_PACKAGE_CONTAINERD=y
BR2_PACKAGE_RUNC=y
BR2_PACKAGE_DOCKER_CLI=y
BR2_PACKAGE_DOCKER_ENGINE=y

# ---- Runtime dependencies auto-selected by the above, made explicit ----
BR2_PACKAGE_IPTABLES=y                 # docker-engine runtime dep (NAT/firewall rules)
BR2_PACKAGE_CGROUPFS_V2_MOUNT=y        # docker-engine runtime dep; mount cgroup2 at /sys/fs/cgroup
# BR2_PACKAGE_CGROUPFS_MOUNT is not set   # MUST stay off (docker-engine conflicts with it)
BR2_PACKAGE_UTIL_LINUX=y               # containerd runtime dep (mount, pivot_root, mountpoint)
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_PIVOT_ROOT=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y

# ---- Recommended extras ----
# docker-init (tiny init for `docker run --init` / signal handling). Pick ONE:
BR2_PACKAGE_DOCKER_ENGINE_DOCKER_INIT_TINI=y
# BR2_PACKAGE_DOCKER_ENGINE_DOCKER_INIT_NONE is not set
# BR2_PACKAGE_DOCKER_ENGINE_DOCKER_INIT_CATATONIT is not set

# ---- Kernel features Docker/runc NEED inside the guest ----
# These are enabled in the board/qemu/x86_64/linux.config reference, but the
# browser-buildroot kernel config may not have them all. Enable as needed:
#   CONFIG_CGROUPS=y            (cgroup v1+v2)
#   CONFIG_NAMESPACES=y
#   CONFIG_UTS_NS=y CONFIG_IPC_NS=y CONFIG_PID_NS=y CONFIG_NET_NS=y
#   CONFIG_USER_NS=y            (optional, for rootless-style builds)
#   CONFIG_NET=y CONFIG_NETFILTER=y CONFIG_IP_NF_IPTABLES=y CONFIG_IP_NF_NAT=y
#   CONFIG_VETH=y CONFIG_OVERLAY_FS=y CONFIG_VIRTIO_NET=y CONFIG_9P_FS=y
#   CONFIG_POSIX_MQUEUE=y
#   CONFIG_MEMCG=y  (memory cgroup; docker info uses it)

# ---- Runtime notes (in the guest, after boot) ----
#   mount -t cgroup2 none /sys/fs/cgroup          (if not auto-mounted)
#   containerd &  # start daemons
#   dockerd     &
#   docker run --rm hello-world
